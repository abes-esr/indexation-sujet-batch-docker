#
# Ci-dessous les variables pour configurer les conteneurs de ia rameau
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Caping for containers
######################################################
MEM_LIMIT=8g
CPU_LIMIT=8

######################################################
# Paramétrage version
######################################################
IAR_BATCH_DUMP_VERSION=test-batch-dump

######################################################
# Paramétrage de iar-batch-dump
######################################################
IAR_BATCH_SPRING_PROFILES_ACTIVE=dist
IAR_BATCH_JAVA_TOOL_OPTIONS=
IAR_BATCH_OUTPUT_DIR=
IAR_BATCH_UPLOAD_URL=
IAR_BATCH_VECTORIZATION_URL=
IAR_BATCH_CHUNK_SIZE=
IAR_BATCH_SOURCE_TABLE=
IAR_BATCH_TEST_OUTPUT_DIR=

IAR_ORACLE_HOST=
IAR_ORACLE_PORT=
IAR_ORACLE_SERVICE=
IAR_ORACLE_USER=
IAR_ORACLE_PASSWORD=

IAR_BATCH_TEST_OUTPUT_DIR=
IAR_BATCH_TEST_PROCEDURE_FILENAME=
IAR_BATCH_TEST_REQUETE_FILENAME=
IAR_BATCH_TEST_SOURCE_TABLE=
IAR_BATCH_TEST_CHUNK_SIZE=

IAR_ORACLE_TEST_HOST=
IAR_ORACLE_TEST_PORT=
IAR_ORACLE_TEST_SERVICE=
IAR_ORACLE_TEST_USER=
IAR_ORACLE_TEST_PASSWORD=

IAR_BATCH_AT_STARTUP=0