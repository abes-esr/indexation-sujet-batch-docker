#
# Ci-dessous les variables pour configurer les conteneurs de ia rameau
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Caping for containers
######################################################
MEM_LIMIT=8g
CPU_LIMIT=8

######################################################
# Paramétrage version
######################################################
IAR_BATCH_DUMP_VERSION=test-batch-dump

######################################################
# Paramétrage de iar-batch-dump
######################################################
IAR_BATCH_SPRING_PROFILES_ACTIVE=localhost
IAR_BATCH_JAVA_TOOL_OPTIONS=
IAR_BATCH_OUTPUT_DIR=
IAR_BATCH_UPLOAD_URL=
IAR_BATCH_VECTORIZATION_URL=
IAR_BATCH_CHUNK_SIZE=
IAR_BATCH_SOURCE_TABLE=
IAR_BATCH_TEST_OUTPUT_DIR=
ORACLE_HOST=
ORACLE_PORT=
ORACLE_SERVICE=
ORACLE_USER=
ORACLE_PASSWORD=