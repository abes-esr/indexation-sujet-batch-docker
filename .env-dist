#
# Ci-dessous les variables pour configurer les conteneurs de ia rameau
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Caping for containers
######################################################
MEM_LIMIT=8g
CPU_LIMIT=8

######################################################
# Paramétrage version
######################################################
INDEXATION_SUJET_BATCH_VERSION=test-batch


######################################################
# Paramétrage de indexation-sujet-batch
######################################################
SPRING_PROFILES_ACTIVE=
JAVA_TOOL_OPTIONS=
INDEXATION_SUJET_BATCH_AT_STARTUP=
INDEXATION_SUJET_BATCH_CRON=


INDEXATION_SUJET_BATCH_OUTPUT_DIR=
INDEXATION_SUJET_BATCH_UPLOAD_URL=
INDEXATION_SUJET_BATCH_OUTPUT_FILENAME=
INDEXATION_SUJET_BATCH_CHUNK_SIZE=
INDEXATION_SUJET_BATCH_SOURCE_TABLE=

INDEXATION_SUJET_ORACLE_HOST=
INDEXATION_SUJET_ORACLE_PORT=
INDEXATION_SUJET_ORACLE_SERVICE=
INDEXATION_SUJET_ORACLE_USER=
INDEXATION_SUJET_ORACLE_PASSWORD=


INDEXATION_SUJET_BATCH_TEST_OUTPUT_DIR=
INDEXATION_SUJET_BATCH_TEST_PROCEDURE_FILENAME=
INDEXATION_SUJET_BATCH_TEST_REQUETE_FILENAME=
INDEXATION_SUJET_BATCH_TEST_CHUNK_SIZE=
INDEXATION_SUJET_BATCH_TEST_SOURCE_TABLE=


INDEXATION_SUJET_ORACLE_TEST_HOST=
INDEXATION_SUJET_ORACLE_TEST_PORT=
INDEXATION_SUJET_ORACLE_TEST_SERVICE=
INDEXATION_SUJET_ORACLE_TEST_USER=
INDEXATION_SUJET_ORACLE_TEST_PASSWORD=

